<div class="row">
    <div class="col-9">
        <h2 class="text-primary">National Park List</h2>
    </div>
    <div class="col-3">
        <a asp-action="Upsert" class="btn btn-primary form-control">
            <i class="fas fa-plus"></i>&emsp; Create National Park</a>
    </div>
</div>
<div class="container rounded-3 border p-2 m-2">
    <table id="tblData" class="table table-bordered table-active table-bordered table-hover">
        <thead>
            <tr>
                <th>Name</th>
                <th>State</th>
                <th>Action</th>
            </tr>
        </thead>
    </table>
</div>
@section Scripts{
    <script src="~/js/nationalPark.js"></script>
}