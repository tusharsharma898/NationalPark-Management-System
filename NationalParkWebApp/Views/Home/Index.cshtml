@model NationalParkWebApp.Models.ViewModels.IndexVM

<table id="tblNationalParks" class="table table-borderless">
    <thead>
        <tr>
            <th>National Park</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var nationalPark in Model.NationalParkList)
        {
            <tr>
                <td>
                    <div class="container backgroundWhite pb-4">
                        <div class="card border">
                            <div class="card-header bg-dark text-light ml-0 row container">
                                <div class="col-12 col-md-6">
                                    <h1 class="text-warning">
                                        @nationalPark.Name
                                    </h1>
                                </div>

                                <div class="col-12 col-md-6 text-md-right">
                                    <h1 class="text-warning">
                                        State : @nationalPark.State
                                    </h1>
                                </div>
                            </div>

                            <div class="card-body">
                                <div class="container rounded p-2">
                                    <div class="row">
                                        <div class="col-12 col-lg-8">
                                            <div class="row">
                                                <div class="col-12">
                                                    <h3 style="color:#bbb9b9">
                                                        Established: @nationalPark.Established.Year
                                                    </h3>
                                                </div>

                                                <div class="col-12">
                                                    @{
                                                        var trails = Model.TrailList
                                                            .Where(tr => tr.NationalParkId == nationalPark.Id);
                                                    }

                                                    <table class="table table-striped table-bordered">
                                                        <thead>
                                                            <tr class="table-secondary">
                                                                <th>Trail</th>
                                                                <th>Distance</th>
                                                                <th>Elevation Gain</th>
                                                                <th>Difficulty</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var trail in trails)
                                                            {
                                                                <tr>
                                                                    <td>@trail.Name</td>
                                                                    <td>@trail.Distance</td>
                                                                    <td>@trail.Elevation</td>
                                                                    <td>@trail.Difficulty</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12 col-lg-4 text-center">
                                            @if (nationalPark.Picture != null)
                                            {
                                                var base64 = Convert.ToBase64String(nationalPark.Picture);
                                                var imgSrc = string.Format(
                                                    "data:image/jpg;base64,{0}", base64);

                                                <img src="@imgSrc"
                                                     class="card-img-top p-2 rounded"
                                                     width="100%" />
                                            }
                                        </div>
                                        <div class="text-end mt-3">

                                            <div class="text-end mt-3">
                                                <a asp-controller="Appointment" asp-action="Create"asp-route-nationalParkId="@nationalPark.Id"class="btn btn-primary">
                                                Book Appointment
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="~/js/Index.js"></script>
}
