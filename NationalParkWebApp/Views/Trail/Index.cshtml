<div class="row">
    <div class="col-9">
        <h2 class="text-primary">Trails List</h2>
    </div>
    <div class="col-3">
        <a asp-action="Upsert" class="btn btn-primary form-control">
            <i class="fas fa-plus"></i>&emsp; Create Trail</a>
    </div>
</div>
<div class="rounded-3 border p-2 m-2">
    <table id="tblData" class="table table-active table-bordered table-hover table-striped">
        <thead>
            <tr>
                <th>National Park</th>
                <th>trail Name</th>
                <th>Distance</th>
                <th>Elevation</th>
                <th>Actions</th>
            </tr>
        </thead>
    </table>
</div>
@section Scripts{
    <script src="~/js/trail.js"></script>
}